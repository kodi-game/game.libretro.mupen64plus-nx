msgctxt "#30142"
msgid "(GLN64) Select the aspect ratio. 'adjusted' means essentially Widescreen hacks."
msgstr "(GLN64) Vyberte poměr stran. „adjusted“ v podstatě znamená hacky pro širokoúhlý obraz."

msgctxt "#30143"
msgid "Original (4:3)"
msgstr "Původní (4:3)"

msgctxt "#30144"
msgid "Wide (Stretched)"
msgstr "Širokoúhlý (roztáhnutý)"

msgctxt "#30145"
msgid "Wide (Adjusted)"
msgstr "Širokoúhlý (upravený)"

msgctxt "#30146"
msgid "(GLN64) Render at N times the native resolution."
msgstr "(GLN64) Vykreslovat v N-násobku nativního rozlišení."

msgctxt "#30147"
msgid "Disabled"
msgstr "Zakázáno"

msgctxt "#30148"
msgid "1x"
msgstr "1x"

msgctxt "#30149"
msgid "2x"
msgstr "2x"

