msgid "Wide (Stretched)"
msgstr "Bred (utsträckt)"

msgctxt "#30145"
msgid "Wide (Adjusted)"
msgstr "Bred (justerad)"

msgctxt "#30146"
msgid "(GLN64) Render at N times the native resolution."
msgstr "(GLN64) Rendera med N gånger den ursprungliga upplösningen."

