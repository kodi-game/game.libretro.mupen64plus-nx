msgid "Configure GLideN64 Options."
msgstr "Nastavit volby GLideN64."

msgctxt "#30122"
msgid "(GLN64) Select Render Viewport dimensions (4:3)."
msgstr "(GLN64) Vyberte rozměry vykreslovací oblasti (4:3)."

