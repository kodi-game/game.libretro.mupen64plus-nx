msgstr "Angrylion"

msgctxt "#30088"
msgid "ParaLLEl-RDP"
msgstr "ParaLLEl-RDP"

msgctxt "#30089"
msgid "GLideN64"
msgstr "GLideN64"

msgctxt "#30090"
msgid "Select the R4300 CPU Backend, use Interpreter for best compability"
msgstr "Vyberte backend CPU R4300; pro nejlepší kompatibilitu použijte interpret"

msgctxt "#30091"
msgid "Pure Interpreter"
msgstr "Čistý interpret"

msgctxt "#30092"
msgid "Cached Interpreter"
msgstr "Interpret s mezipamětí"

msgctxt "#30093"
msgid "Dynarec"
msgstr "Dynarec"

msgctxt "#30094"
msgid "Select a RSP Plugin, use HLE for best performance, ParaLLEl for best LLE Performance and CXD4 as LLE fallback"
msgstr "Vyberte zásuvný modul RSP; pro nejlepší výkon použijte HLE, pro nejlepší výkon při LLE emulaci ParaLLEl a jako záložní LLE použijte CXD4"

msgctxt "#30095"
msgid "ParaLLEl"
msgstr "ParaLLEl"

msgctxt "#30096"
msgid "CXD4"
msgstr "CXD4"

msgctxt "#30097"
msgid "HLE"
msgstr "HLE"

msgctxt "#30098"
msgid "Enable Frame duplication to improve smoothing on low-end. Different from frameskip."
msgstr "Povolte duplikaci snímků pro plynulejší obraz na méně výkonném hardwaru. Liší se od přeskočení snímků."

msgctxt "#30099"
msgid "Fullspeed will enforce Count per Op 1 and FBEmu settings, this will break some games!"
msgstr "Plná rychlost vynutí hodnotu Count per Op 1 a nastavení FBEmu; některé hry přestanou fungovat!"

msgctxt "#30100"
msgid "Select a VI Refresh clock, Auto does not impact behaviour, other values override CountPerScanline."
msgstr "Vyberte takt obnovovací frekvence VI; Automaticky chování neovlivňuje, ostatní hodnoty přepíší CountPerScanline."

msgctxt "#30101"
msgid "Force disable Expansion Pak (might improve performance for some games while reducing emulation accuracy, will break games that require it)."
msgstr "Vynutit zakázání Expansion Paku (může zlepšit výkon některých her, ale sníží přesnost emulace a hry, které ho vyžadují, přestanou fungovat)."

msgctxt "#30102"
msgid "(HACK) Ignore emulated TLB Exceptions, this might fix some broken romhacks. This option might be removed in the future."
msgstr "(HACK) Ignorovat emulované výjimky TLB; může to opravit některé nefunkční ROM hacky. Tato volba může být v budoucnu odstraněna."

msgctxt "#30103"
msgid "Don't Ignore"
msgstr "Neignorovat"

msgctxt "#30104"
msgid "Ignore TLB Exceptions if not using TLB"
msgstr "Ignorovat výjimky TLB, pokud se TLB nepoužívá"

msgctxt "#30105"
msgid "Always Ignore TLB Exceptions"
msgstr "Vždy ignorovat výjimky TLB"

msgctxt "#30106"
msgid "Count per Op is used to approximate the Counter reg, 0 will use the embedded Database (or default to 2). Changing this will break stuff!"
msgstr "Hodnota Count per Op se používá k aproximaci registru Counter; 0 použije vestavěnou databázi (nebo výchozí hodnotu 2). Změna může způsobit, že něco přestane fungovat!"

msgctxt "#30107"
msgid "Denominator for Count per Op (allowing sub-1 Count per Op in practice). Changing this can break stuff!"
msgstr "Jmenovatel hodnoty Count per Op (v praxi umožňuje hodnotu Count per Op menší než 1). Změna může způsobit, že něco přestane fungovat!"

msgctxt "#30108"
msgid "Pak/Controller Options"
msgstr "Volby Paku/ovladače"

msgctxt "#30109"
msgid "Configure Core Pak/Controller Options."
msgstr "Nastavit volby Paku/ovladače jádra."

msgctxt "#30110"
msgid "Size of the non responsive area around an analog stick."
msgstr "Velikost necitlivé oblasti kolem analogové páčky."

msgctxt "#30111"
msgid "Adjust how far the stick needs to be moved to reach its max value."
msgstr "Upravte vzdálenost posunutí páčky potřebnou k dosažení maximální hodnoty."

msgctxt "#30112"
msgid "Select Right C Button mapping."
msgstr "Vyberte mapování pravého tlačítka C."

msgctxt "#30113"
msgid "Select Left C Button mapping."
msgstr "Vyberte mapování levého tlačítka C."

msgctxt "#30114"
msgid "Select Down C Button mapping."
msgstr "Vyberte mapování dolního tlačítka C."

msgctxt "#30115"
msgid "Select Up C Button mapping."
msgstr "Vyberte mapování horního tlačítka C."

msgctxt "#30116"
msgid "Use an alternate control scheme, useful for some 3rdparty controllers."
msgstr "Používat alternativní schéma ovládání, užitečné pro některé ovladače třetích stran."

msgctxt "#30117"
msgid "Select Player 1 Controller Pak."
msgstr "Vyberte Pak ovladače hráče 1."

msgctxt "#30118"
msgid "Select Player 2 Controller Pak."
msgstr "Vyberte Pak ovladače hráče 2."

msgctxt "#30119"
msgid "Select Player 3 Controller Pak."
msgstr "Vyberte Pak ovladače hráče 3."

msgctxt "#30120"
msgid "Select Player 4 Controller Pak."
msgstr "Vyberte Pak ovladače hráče 4."

