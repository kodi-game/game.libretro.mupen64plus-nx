     }else{
-      *ptr4=0x58000000|((8>>2)<<5)|18; // ldr x18,[pc,#8]
-      *(ptr4+1)=0xd61f0000|(18<<5);
+      *ptr4=0x58000000|((8>>2)<<5)|HOST_TRAMPREG; // ldr scratch,[pc,#8]
+      *(ptr4+1)=0xd61f0000|(HOST_TRAMPREG<<5);
     }
     ptr2++;
     *ptr2=*ptr;
@@ -4625,5 +4639,6 @@ static void arch_init(void) {
     ptr3+=2;
   }
 
-  __clear_cache((char *)base_addr+(1<<TARGET_SIZE_2)-JUMP_TABLE_SIZE,(char *)base_addr+(1<<TARGET_SIZE_2));
+  cache_flush((char *)base_addr+(1<<TARGET_SIZE_2)-JUMP_TABLE_SIZE,(char *)base_addr+(1<<TARGET_SIZE_2));
+  M64P_JIT_WRITE_END();
 }
